rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'mubashirtazim2k@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profiles ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == userId &&
               data.email is string &&
               data.role in ['admin', 'author', 'reader'];
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && 
                    isValidUser(incoming()) && 
                    // Prevent users from changing their own role unless admin
                    (isAdmin() || incoming().role == existing().role);
    }

    // --- Posts ---
    match /posts/{postId} {
      function isValidPost(data) {
        return data.title is string && data.title.size() > 0 && data.title.size() < 300 &&
               data.slug is string && data.slug.size() > 0 &&
               data.content is string &&
               data.status in ['draft', 'published'] &&
               data.authorId is string &&
               isValidId(postId);
      }

      allow read: if incoming().status == 'published' || isAdmin() || isOwner(existing().authorId);
      allow create: if isSignedIn() && (isAdmin() || incoming().authorId == request.auth.uid) && isValidPost(incoming());
      allow update: if isSignedIn() && (isAdmin() || isOwner(existing().authorId)) && isValidPost(incoming());
      allow delete: if isSignedIn() && (isAdmin() || isOwner(existing().authorId));
    }

    // --- Comments ---
    match /comments/{commentId} {
      function isValidComment(data) {
        return data.postId is string &&
               data.userId == request.auth.uid &&
               data.content is string && data.content.size() > 0 && data.content.size() < 2000;
      }

      allow read: if true;
      allow create: if isSignedIn() && isValidComment(incoming());
      allow update: if isOwner(existing().userId) && isValidComment(incoming());
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    // --- Newsletter ---
    match /newsletter/{email} {
      allow create: if incoming().email == email;
      allow read, update, delete: if isAdmin();
    }

    // --- Likes/Bookmarks ---
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
